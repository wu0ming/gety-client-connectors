{
	"name": "@local/dsh-gety-connector",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Connect DeepSeek Harness to GetY and choose which workspaces GetY may index.",
	"exports": {
		".": "./index.js",
		"./client": "./client.js",
		"./icon": "./icon.svg",
		"./locale/*.json": "./locale/*.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-plugin-manager"
			]
		}
	},
	"files": [
		"index.js",
		"client.js",
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json",
		"connector/**"
	]
}
